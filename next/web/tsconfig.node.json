{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "mock/**/*.ts", "scripts/**/*.ts", "packages/ui/src/icons.ts", "src/authz/implies.ts", "src/generated/permissions.ts", "src/views/usage/view.ts", "src/views/accounts/headerOverride/model.ts", "src/views/accounts/controls/jsonObject.ts", "src/views/accounts/protocols/protocolBinding.ts", "src/api/types.ts", "src/api/pluginKeys.ts", "src/api/pricing.ts", "src/views/prices/priceExpr.ts", "src/views/prices/priceCheck.ts", "src/views/prices/presets.ts", "src/views/settings/pluginEgress.ts", "src/views/topup/rounding.ts"]
}
