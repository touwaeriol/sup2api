-- sql
INSERT INTO "segment_groups" ("segment_id","group_id","granted","rate_override") VALUES ($1,$2,$3,$4) ON CONFLICT ("segment_id","group_id") DO UPDATE SET "granted"=COALESCE($5, segment_groups.granted),"rate_override"=EXCLUDED.rate_override,"updated_at"=now()
-- vars
$1 int64 3
$2 int64 4
$3 bool false
$4 *decimal.Decimal 0.8
$5 *bool nil
