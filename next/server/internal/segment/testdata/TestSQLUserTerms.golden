-- sql
SELECT g.id AS group_id, s.id AS segment_id, COALESCE(sg.granted, false) AS granted, g.visibility = 'public' AS public,
	g.rate_multiplier, sg.rate_override FROM groups g JOIN segments s ON s.id = (SELECT u.segment_id FROM users u WHERE u.id = $1 AND u.deleted_at IS NULL) LEFT JOIN segment_groups sg ON sg.segment_id = s.id AND sg.group_id = g.id WHERE g.id = ANY($2)
-- vars
$1 int64 7
$2 store.Int64s [1 2]
