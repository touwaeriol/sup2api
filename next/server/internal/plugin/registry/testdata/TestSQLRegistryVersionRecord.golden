-- sql
SELECT v.manifest, v.package_sha256, v.package_url, v.signature_status, p.name, (SELECT COALESCE(tv.trust_level, tp.trust_level) FROM plugin_versions AS tv LEFT JOIN publishers tp ON tp.id = tv.publisher_id WHERE tv.plugin_key = v.plugin_key AND tv.version = v.version), (SELECT "installed_at" FROM "plugins" WHERE key = v.plugin_key) FROM plugin_versions AS v LEFT JOIN publishers p ON p.id = v.publisher_id WHERE v.plugin_key = $1 AND v.version = $2
-- vars
$1 string "demo"
$2 string "1.2.0"
