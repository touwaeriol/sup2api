[
  {
    "name": "one request tier (an old per-request price)",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "base",
          "unit": "request",
          "price": 0.01
        }
      ],
      "rules": []
    },
    "expression": "tier(\"base\", flat(0.01))"
  },
  {
    "name": "one request tier with rules",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "base",
          "unit": "request",
          "price": 0.04
        }
      ],
      "rules": [
        {
          "name": "hd",
          "multiplier": 2,
          "conds": [
            {
              "source": "param",
              "key": "quality",
              "op": "eq",
              "value": "hd"
            }
          ]
        },
        {
          "name": "night",
          "multiplier": 0.5,
          "conds": [
            {
              "source": "time",
              "tz": "Asia/Shanghai",
              "from_hour": 0,
              "to_hour": 8
            }
          ]
        }
      ]
    },
    "expression": "(tier(\"base\", flat(0.04))) * (param(\"quality\") == \"hd\" ? 2 : 1) * (hour(\"Asia/Shanghai\") >= 0 && hour(\"Asia/Shanghai\") < 8 ? 0.5 : 1)"
  },
  {
    "name": "one tier, every price",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "base",
          "unit": "token",
          "p": 5,
          "c": 40,
          "cr": 1.25,
          "cc": 6.25,
          "cc1h": 10,
          "img": 10,
          "img_o": 40
        }
      ],
      "rules": []
    },
    "expression": "tier(\"base\", p*5 + c*40 + cr*1.25 + cc*6.25 + cc1h*10 + img*10 + img_o*40)"
  },
  {
    "name": "one tier, p and c only, a cache price of 0",
