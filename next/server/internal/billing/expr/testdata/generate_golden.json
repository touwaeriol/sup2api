    "expression": "len > 200000 && (hour(\"Asia/Shanghai\") >= 22 || hour(\"Asia/Shanghai\") < 6) ? tier(\"long_night\", p*4 + c*18) : (len > 200000 ? tier(\"long\", p*6 + c*22.5) : tier(\"base\", p*3 + c*15))"
  },
  {
    "name": "conditions: or over and, not, groups of one",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "heavy",
          "when": {
            "or": [
              {
                "var": "c",
                "op": ">=",
                "value": 4096
              },
              {
                "and": [
                  {
                    "and": [
                      {
                        "var": "p",
                        "op": ">",
                        "value": 100000
                      },
                      {
                        "var": "len",
                        "op": "<=",
                        "value": 400000
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "unit": "token",
          "p": 5,
          "c": 25
        },
        {
          "name": "not_small",
          "when": {
            "not": {
              "or": [
                {
                  "var": "len",
                  "op": "<",
                  "value": 1000
                }
              ]
            }
          },
          "unit": "token",
          "p": 2,
          "c": 10
        },
        {
          "name": "one",
          "when": {
            "and": [
              {
                "var": "p",
                "op": "<",
                "value": 10
              }
            ]
          },
          "unit": "request",
          "price": 0.001
        },
        {
          "name": "rest",
          "unit": "token",
          "p": 1,
          "c": 5
        }
      ],
      "rules": []
    },
    "expression": "c >= 4096 || (p > 100000 && len <= 400000) ? tier(\"heavy\", p*5 + c*25) : (!(len < 1000) ? tier(\"not_small\", p*2 + c*10) : (p < 10 ? tier(\"one\", flat(0.001)) : tier(\"rest\", p*1 + c*5)))"
  },
  {
    "name": "conditions: not over a group, nested five deep",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "deep",
          "when": {
            "not": {
              "and": [
                {
                  "var": "len",
                  "op": ">",
                  "value": 1
                },
                {
                  "or": [
                    {
                      "not": {
                        "var": "c",
                        "op": "==",
                        "value": 0
                      }
                    },
                    {
                      "var": "p",
                      "op": "!=",
                      "value": 2
                    }
                  ]
                }
              ]
            }
          },
          "unit": "token",
          "p": 1
        },
        {
          "name": "rest",
          "unit": "token",
          "p": 2
        }
      ],
      "rules": []
    },
    "expression": "!(len > 1 && (!(c == 0) || p != 2)) ? tier(\"deep\", p*1 + c*0) : tier(\"rest\", p*2 + c*0)"
  },
  {
    "name": "conditions: every time quantity, zones and a blank zone",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "night",
          "when": {
            "var": "hour",
            "tz": "Asia/Shanghai",
            "op": ">=",
            "value": 22
          },
          "unit": "token",
          "p": 1,
          "c": 1
        },
        {
          "name": "half_past",
          "when": {
            "var": "minute",
            "tz": "",
            "op": "==",
            "value": 30
          },
          "unit": "token",
          "p": 2,
          "c": 2
        },
        {
          "name": "saturday",
          "when": {
            "var": "weekday",
            "tz": "America/New_York",
            "op": "==",
            "value": 6
          },
          "unit": "token",
          "p": 3,
          "c": 3
        },
        {
          "name": "december",
          "when": {
            "var": "month",
            "op": "==",
            "value": 12
          },
          "unit": "token",
          "p": 4,
          "c": 4
        },
