          "name": "month_start",
          "when": {
            "var": "day",
            "tz": "Europe/London",
            "op": "<=",
            "value": 7
          },
          "unit": "token",
          "p": 5,
          "c": 5
        },
        {
          "name": "rest",
          "unit": "token",
          "p": 6,
          "c": 6
        }
      ],
      "rules": []
    },
    "expression": "hour(\"Asia/Shanghai\") >= 22 ? tier(\"night\", p*1 + c*1) : (minute(\"UTC\") == 30 ? tier(\"half_past\", p*2 + c*2) : (weekday(\"America/New_York\") == 6 ? tier(\"saturday\", p*3 + c*3) : (month(\"UTC\") == 12 ? tier(\"december\", p*4 + c*4) : (day(\"Europe/London\") <= 7 ? tier(\"month_start\", p*5 + c*5) : tier(\"rest\", p*6 + c*6)))))"
  },
  {
    "name": "conditions: p and c, under a rule",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "big_in_small_out",
          "when": {
            "and": [
              {
                "var": "p",
                "op": ">=",
                "value": 100000
              },
              {
                "var": "c",
                "op": "<",
                "value": 500
              }
            ]
          },
          "unit": "token",
          "p": 2,
          "c": 8,
          "cr": 0.2
        },
        {
          "name": "rest",
          "unit": "token",
          "p": 3,
          "c": 15,
          "cr": 0.3
        }
      ],
      "rules": [
        {
          "name": "fast",
