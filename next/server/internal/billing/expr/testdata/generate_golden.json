  {
    "name": "four tiers, nested from the third",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "short",
          "when": {
            "var": "len",
            "op": "<=",
            "value": 32000
          },
          "unit": "token",
          "p": 1,
          "c": 5
        },
        {
          "name": "mid",
          "when": {
            "var": "len",
            "op": "<=",
            "value": 128000
          },
          "unit": "token",
          "p": 2,
          "c": 10
        },
        {
          "name": "long",
          "when": {
            "var": "len",
            "op": "<=",
            "value": 256000
          },
          "unit": "token",
          "p": 3,
          "c": 15
        },
        {
          "name": "rest",
          "unit": "token",
          "p": 4,
          "c": 20
        }
      ],
      "rules": []
    },
    "expression": "len <= 32000 ? tier(\"short\", p*1 + c*5) : (len <= 128000 ? tier(\"mid\", p*2 + c*10) : (len <= 256000 ? tier(\"long\", p*3 + c*15) : tier(\"rest\", p*4 + c*20)))"
  },
  {
    "name": "a per-request tier",
    "mode": "visual",
    "config": {
      "tiers": [
        {
          "name": "base",
          "when": {
            "var": "len",
            "op": "<=",
