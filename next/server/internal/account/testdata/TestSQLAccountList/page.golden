-- sql
SELECT a.id, a.name, a.plugin_key, a.type, NULL::bytea, a.settings, a.proxy_id,
	a.status, a.status_reason, a.schedulable, a.auto_disable, a.priority, a.weight, a.max_concurrency,
	a.models, a.model_mapping, a.rpm_limit, a.tpm_limit, a.spm_limit, a.spm_window_seconds, a.model_limits, a.environment, a.last_used_at,
	a.created_by, u.email, a.owner_id, o.email, a.created_at, a.updated_at,
	a.last_test_at, a.last_test_ok, a.last_test_latency_ms::bigint, a.last_test_model, a.last_test_message, a.auto_disabled_until,
	a.last_test_status,a.last_test_error_code,a.last_test_error_source,a.auto_disabled_source,a.header_passthrough,a.param_override,a.conversion_loss_policy,a.admin_locked,a.header_override,
	a.protocols, a.model_protocols, a.last_test_protocol, (SELECT count(*) FROM accounts a WHERE a.deleted_at IS NULL AND (($1::boolean OR COALESCE(a.owner_id = ANY($2::bigint[]) OR a.owner_id IN (SELECT "id" FROM "users" WHERE "owner_path" && $3), false) OR a.id = ANY($4::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($5::boolean OR ag.group_id = ANY($6::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($7::bigint[], $8::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) AND a.plugin_key = ANY($9) AND ((a.status = $10 OR (a.status = 'active' AND NOT a.schedulable))) AND a.id = ANY($11) AND a.name ILIKE '%' || $12 || '%') FROM accounts a LEFT JOIN users u ON u.id = a.created_by LEFT JOIN users o ON o.id = a.owner_id WHERE a.deleted_at IS NULL AND (($13::boolean OR COALESCE(a.owner_id = ANY($14::bigint[]) OR a.owner_id IN (SELECT "id" FROM "users" WHERE "owner_path" && $15), false) OR a.id = ANY($16::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($17::boolean OR ag.group_id = ANY($18::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($19::bigint[], $20::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) AND a.plugin_key = ANY($21) AND ((a.status = $22 OR (a.status = 'active' AND NOT a.schedulable))) AND a.id = ANY($23) AND a.name ILIKE '%' || $24 || '%' ORDER BY a.created_at DESC, a.id DESC LIMIT $25 OFFSET $26
