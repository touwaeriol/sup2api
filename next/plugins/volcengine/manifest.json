  "database": {
    "schema": "plg_volcengine",
    "migrations": "migrations/"
  },
  "userPermissions": [
    {
      "key": "assets:read",
      "defaults": { "admin": true },
      "label": {
        "en": "View the Ark asset library",
        "zh": "查看方舟素材库"
      },
      "description": {
        "en": "The asset and asset group pages, and the live listing of what an account holds upstream",
        "zh": "素材与素材组页面，以及账号上游素材的实时列表"
      }
    },
    {
      "key": "assets:manage",
      "defaults": { "admin": true },
      "label": {
        "en": "Manage the Ark asset library",
        "zh": "管理方舟素材库"
      },
      "description": {
        "en": "Create, rename and delete asset groups and assets on the Volcengine side",
        "zh": "在火山方舟上创建、改名、删除素材组与素材"
      }
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/accounts",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read"
      }
    },
    {
      "method": "GET",
      "path": "/asset-groups",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read"
      }
    },
    {
      "method": "POST",
      "path": "/asset-groups",
      "scope": "admin",
      "permission": "assets:manage",
      "accounts": {
        "action": "update",
        "from": ["body:account_id"]
      }
    },
    {
      "method": "GET",
      "path": "/asset-groups/:id",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read"
      }
    },
    {
      "method": "PATCH",
      "path": "/asset-groups/:id",
      "scope": "admin",
      "permission": "assets:manage",
      "accounts": {
        "action": "update"
      }
    },
    {
      "method": "DELETE",
      "path": "/asset-groups/:id",
      "scope": "admin",
      "permission": "assets:manage",
      "accounts": {
        "action": "update"
      }
    },
    {
      "method": "GET",
      "path": "/assets",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read"
      }
    },
    {
      "method": "POST",
      "path": "/assets",
      "scope": "admin",
      "permission": "assets:manage",
      "accounts": {
        "action": "update"
      }
    },
    {
      "method": "GET",
      "path": "/assets/:id",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read"
      }
    },
    {
      "method": "PATCH",
      "path": "/assets/:id",
      "scope": "admin",
      "permission": "assets:manage",
      "accounts": {
        "action": "update"
      }
    },
    {
      "method": "DELETE",
      "path": "/assets/:id",
      "scope": "admin",
      "permission": "assets:manage",
      "accounts": {
        "action": "update"
      }
    },
    {
      "method": "GET",
      "path": "/accounts/:account_id/upstream/asset-groups",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read",
        "from": ["path:account_id"]
      }
    },
    {
      "method": "GET",
      "path": "/accounts/:account_id/upstream/assets",
      "scope": "admin",
      "permission": "assets:read",
      "accounts": {
        "action": "read",
        "from": ["path:account_id"]
      }
    }
  ],
  "ui": {
    "native": {
      "entry": "ui/native/entry.js"
    },
    "sections": [
      {
        "id": "volcengine",
        "label": {
          "en": "Volcengine Ark",
