{
  "apiVersion": 1,
  "key": "volcengine",
  "name": {
    "en": "Volcengine Ark",
    "zh": "字节火山方舟"
  },
  "description": {
    "en": "Official Volcengine Ark access for OpenAI-compatible APIs, Anthropic Messages, image and video generation. Existing relay text integrations remain compatible. Prices are configured by the administrator.",
    "zh": "提供方舟官方 OpenAI 兼容接口、Anthropic Messages、图片与视频生成。保留既有中转文本接入兼容，不内置价格。"
  },
  "version": "0.13.0",
  "publisher": "sub2api",
  "icon": "assets/volcengine-color.svg",
  "runtime": "grpc",
  "entry": {
    "grpc": {
      "binaries": "runtimes/{os}-{arch}/plugin"
    }
  },
  "hostCompat": ">=0.1.304 <0.2.0",
  "hostUICompat": "^4.0",
  "capabilities": [
    {
      "id": "platform.adapter.v1"
    },
    {
      "id": "platform.tasks.v1"
    },
    {
      "id": "platform.monitor.v1"
    },
    {
      "id": "http.routes.v1"
    }
  ],
  "platforms": [
    {
      "id": "volcengine",
      "label": {
        "en": "Volcengine Ark",
        "zh": "火山方舟"
      },
      "passHeaders": [
        "user-agent"
      ],
      "usage": {
        "semantics": "inclusive"
      },
      "endpoints": [
        {
          "id": "images",
          "method": "POST",
          "path": "/api/v3/images/generations",
          "protocol": "volcengine.images",
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {
            "modelPath": "model",
            "promptTextPaths": [
              "prompt"
            ]
          },
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "usage",
          "usage": {
            "semantics": "inclusive",
            "json": {
              "map": {
                "model": "model",
                "output_tokens": "usage.output_tokens"
              }
            },
            "facts": {
              "images": {
                "type": "number",
                "unit": "image",
                "path": "usage.generated_images",
                "description": {
                  "en": "Images the request generated (usage.generated_images), for price expressions such as u(\"images\") * 0.03",
                  "zh": "本次请求生成的图片张数（usage.generated_images），价格表达式里写 u(\"images\") * 0.03"
                }
              }
            }
          },
          "billingTypes": [
            "per_request",
            "per_token",
            "expression"
          ]
        },
        {
          "id": "video_submit",
          "method": "POST",
          "path": "/api/v3/contents/generations/tasks",
          "protocol": "volcengine.video_submit",
          "task": {
            "action": "submit",
            "kind": "video",
            "idPaths": [
              "id",
              "task_id",
              "data.id",
              "result.id"
            ]
          },
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {
            "modelPath": "model",
            "promptTextPaths": [
              "content.#.text"
            ]
          },
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "usage",
          "usageSource": "plugin",
          "usageRequestFields": [
            "resolution",
            "ratio",
            "duration",
            "frames",
            "content.#",
            "content.#.type",
            "draft",
            "content.0.text",
            "content.1.text",
            "content.2.text"
          ],
          "usage": {
            "semantics": "inclusive",
            "facts": {
              "resolution": {
                "type": "enum",
                "enum": [
                  "480p",
                  "720p",
                  "1080p",
                  "4k"
                ],
                "description": {
                  "en": "Output tier of the clip: the plugin's estimate while the task runs, the tier Ark really rendered once it is reconciled. For tiered price expressions such as tier(u(\"resolution\"), ...)",
                  "zh": "视频的输出档位：任务进行中是插件的预估值，核对完成后是方舟实际渲染的档位。用于分档价格表达式，如 tier(u(\"resolution\"), …)"
                }
              },
              "video_seconds": {
                "type": "number"
              },
              "video_pixels": {
                "type": "number"
              },
              "video_width": {
                "type": "number"
              },
              "video_height": {
                "type": "number"
              },
              "video_estimated": {
                "type": "boolean"
              },
              "video_input": {
                "type": "boolean"
              },
              "video_draft": {
                "type": "boolean"
              }
            }
          },
          "billingTypes": [
            "per_request",
            "per_token",
            "expression",
            "video"
          ]
        },
        {
          "id": "video_query",
          "method": "GET",
          "path": "/api/v3/contents/generations/tasks/:task_id",
          "protocol": "volcengine.video_query",
          "task": {
            "action": "query",
            "kind": "video",
            "idParam": "task_id",
            "idPaths": [
              "id",
              "task_id",
              "data.id",
              "result.id"
            ]
          },
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {},
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "free"
        },
        {
          "id": "v1_video_submit",
          "method": "POST",
          "path": "/v1/contents/generations/tasks",
          "protocol": "volcengine.video_submit",
          "task": {
            "action": "submit",
            "kind": "v1_video",
            "idPaths": [
              "id",
              "task_id",
              "data.id",
              "result.id"
            ]
          },
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {
            "modelPath": "model",
            "promptTextPaths": [
              "content.#.text"
            ]
          },
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "usage",
          "usageSource": "plugin",
          "usageRequestFields": [
            "resolution",
            "ratio",
            "duration",
            "frames",
            "content.#",
            "content.#.type",
            "draft",
            "content.0.text",
            "content.1.text",
            "content.2.text"
          ],
          "usage": {
            "semantics": "inclusive",
            "facts": {
              "resolution": {
                "type": "enum",
                "enum": [
                  "480p",
                  "720p",
                  "1080p",
                  "4k"
                ],
                "description": {
                  "en": "Output tier of the clip: the plugin's estimate while the task runs, the tier Ark really rendered once it is reconciled. For tiered price expressions such as tier(u(\"resolution\"), ...)",
                  "zh": "视频的输出档位：任务进行中是插件的预估值，核对完成后是方舟实际渲染的档位。用于分档价格表达式，如 tier(u(\"resolution\"), …)"
                }
              },
              "video_seconds": {
                "type": "number"
              },
              "video_pixels": {
                "type": "number"
              },
              "video_width": {
                "type": "number"
              },
              "video_height": {
                "type": "number"
              },
              "video_estimated": {
                "type": "boolean"
              },
              "video_input": {
                "type": "boolean"
              },
              "video_draft": {
                "type": "boolean"
              }
            }
          },
          "billingTypes": [
            "per_request",
            "per_token",
            "expression",
            "video"
          ]
        },
        {
          "id": "v1_video_query",
          "method": "GET",
          "path": "/v1/contents/generations/tasks/:task_id",
          "protocol": "volcengine.video_query",
          "task": {
            "action": "query",
            "kind": "v1_video",
            "idParam": "task_id",
            "idPaths": [
              "id",
              "task_id",
              "data.id",
              "result.id"
            ]
          },
          "kind": "proxy",
          "auth": {
            "headers": [
              "authorization"
            ]
          },
          "request": {},
          "response": {
            "nonStream": "json"
          },
          "errorFormat": "openai",
          "billing": "free"
        }
      ]
    }
  ],
  "accountTypes": [
    {
      "id": "apikey",
      "upstreamFields": ["base_url", "asset_base_url"],
      "label": {
        "en": "Volcengine Ark · Official general",
        "zh": "字节火山方舟 · 官方通用"
      },
      "description": {
        "en": "Use an official Ark API key for OpenAI-compatible APIs, Anthropic Messages and official image/video generation. Messages uses /api/compatible/v1/messages; token counting is not supported. Optional AK/SK credentials enable the official asset library.",
        "zh": "使用官方方舟 API Key 调用 OpenAI 兼容接口、Anthropic Messages、官方图片与豆包视频。Messages 使用 /api/compatible/v1/messages，暂不支持 count_tokens。选填 AK/SK 可启用官方素材库。"
      },
      "form": {
        "mode": "native",
        "component": "VolcengineKeyForm"
      },
      "sensitiveFields": [
        "api_key",
        "secret_key"
      ],
      "settingsFields": [
        "base_url",
        "asset_base_url",
        "asset_region"
      ],
      "guardedSettings": [
        {
          "field": "base_url",
          "allowed": [
            "https://ark.cn-beijing.volces.com",
            "https://ark.ap-southeast.bytepluses.com"
          ],
          "versions": ["/api/v3"]
        },
        {
          "field": "asset_base_url",
          "allowed": [
            "https://ark.cn-beijing.volcengineapi.com"
          ]
        }
      ],
      "defaultModels": [
        "doubao-seed-1-6",
        "doubao-seed-1-6-thinking",
