  "resources": {
    "memoryMB": 64,
    "cpu": 0.2,
    "maxThreads": 32,
    "maxOpenFiles": 128
  },
  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register the \"Ark API key\" and \"Doubao relay key\" account types and the \"volcengine\" platform",
        "zh": "注册「方舟 API Key」与「豆包中转 Key」账号类型，以及 volcengine 平台"
      }
    },
    {
      "id": "gateway.endpoint",
      "reason": {
        "en": "Serve Ark image generation at POST /api/v3/images/generations and Doubao Seedance video generation at POST/GET /api/v3/contents/generations/tasks, the paths of the official Ark API; the same endpoints are also served under /doubao/api/v3",
        "zh": "在 POST /api/v3/images/generations 上提供方舟图片生成，在 POST/GET /api/v3/contents/generations/tasks 上提供豆包 Seedance 视频生成，与方舟官方路径一致；同样的端点也在 /doubao/api/v3 下提供"
      }
    },
    {
      "id": "db.schema",
      "reason": {
        "en": "Keep the local index of asset groups and assets (account id, Ark id, name, type, status, timestamps) in plg_volcengine, so a list page does not need one signed upstream call - and one audited credential read - per account",
