{
  "apiVersion": 1,
  "key": "openai",
  "name": { "en": "OpenAI", "zh": "OpenAI" },
  "description": {
    "en": "OpenAI API key account type for the built-in openai platform (/v1/chat/completions, /v1/responses including its WebSocket mode, /v1/embeddings, /v1/images/generations and the JSON form of /v1/images/edits). The plugin builds the upstream requests; the core sends them, so the plugin itself makes no network connection. Model prices are set by administrators in the core.",
    "zh": "为内置 openai 平台提供 OpenAI API Key 账号类型（/v1/chat/completions、/v1/responses（含 WebSocket 模式）、/v1/embeddings、/v1/images/generations 和 JSON 形式的 /v1/images/edits）。插件构造上游请求，由核心发送，插件自身不发起任何网络连接。模型价格由管理员在核心中配置。"
  },
  "version": "0.5.0",
  "publisher": "sub2api",
  "icon": "assets/openai.svg",
  "runtime": "grpc",
  "entry": {
    "grpc": { "binaries": "runtimes/{os}-{arch}/plugin" }
  },
  "hostCompat": ">=0.1.304 <0.2.0",
  "hostUICompat": "^4.0",

  "capabilities": [
    { "id": "platform.adapter.v1" },
    { "id": "platform.websocket.v1" }
  ],

  "accountTypes": [
    {
      "id": "apikey",
      "label": { "en": "OpenAI", "zh": "OpenAI" },
      "description": {
        "en": "An OpenAI Platform API key, or a key for an OpenAI-compatible endpoint (set Base URL).",
        "zh": "OpenAI 平台的 API Key，或 OpenAI 兼容端点的 Key（需填写 Base URL）。"
      },
      "form": { "mode": "native", "component": "OpenAIKeyForm" },
      "upstreamFields": ["base_url"],
      "sensitiveFields": ["api_key"],
      "settingsFields": ["base_url", "organization", "project"],
      "guardedSettings": [
        { "field": "base_url", "allowed": ["https://api.openai.com"], "versions": ["/v1"] }
      ],
      "defaultModels": [
        "gpt-6.2-astra",
        "gpt-6.2-sol",
        "gpt-6.1-sol",
        "gpt-6.1-terra",
        "gpt-6-astra",
        "gpt-6-sol",
        "gpt-6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-5.4",
        "gpt-5.4-2026-03-05",
        "gpt-5.4-pro",
        "gpt-5.4-pro-2026-03-05",
        "gpt-5.3-chat-latest",
        "gpt-5.3-codex",
        "gpt-5.2",
        "gpt-5.2-2025-12-11",
        "gpt-5.2-chat-latest",
        "gpt-5.2-pro",
        "gpt-5.2-pro-2025-12-11",
        "gpt-5.2-codex",
        "gpt-5.1",
        "gpt-5.1-2025-11-13",
        "gpt-5.1-chat-latest",
        "gpt-5.1-codex",
        "gpt-5.1-codex-mini",
        "gpt-5.1-codex-max",
        "gpt-5",
        "gpt-5-2025-08-07",
        "gpt-5-chat-latest",
        "gpt-5-mini",
        "gpt-5-mini-2025-08-07",
        "gpt-5-nano",
        "gpt-5-nano-2025-08-07",
        "gpt-5-codex",
        "gpt-5-pro",
        "gpt-5-pro-2025-10-06",
        "gpt-5-search-api",
        "gpt-5-search-api-2025-10-14",
        "gpt-4.1",
        "gpt-4.1-2025-04-14",
        "gpt-4.1-mini",
        "gpt-4.1-mini-2025-04-14",
        "gpt-4.1-nano",
        "gpt-4.1-nano-2025-04-14",
        "gpt-4o",
        "gpt-4o-2024-05-13",
        "gpt-4o-2024-08-06",
        "gpt-4o-2024-11-20",
        "chatgpt-4o-latest",
        "gpt-4o-mini",
        "gpt-4o-mini-2024-07-18",
        "gpt-4o-search-preview",
        "gpt-4o-mini-search-preview",
        "o1",
        "o1-2024-12-17",
        "o1-pro",
        "o1-pro-2025-03-19",
        "o3",
        "o3-2025-04-16",
        "o3-pro",
        "o3-pro-2025-06-10",
        "o3-mini",
        "o3-mini-2025-01-31",
        "o3-deep-research",
        "o3-deep-research-2025-06-26",
        "o4-mini",
        "o4-mini-2025-04-16",
        "o4-mini-deep-research",
        "o4-mini-deep-research-2025-06-26",
        "gpt-4-turbo",
        "gpt-4-turbo-2024-04-09",
        "gpt-4",
        "gpt-3.5-turbo",
        "computer-use-preview",
        "computer-use-preview-2025-03-11",
        "text-embedding-3-small",
        "text-embedding-3-large",
        "text-embedding-ada-002",
        "gpt-image-2",
        "gpt-image-1.5",
        "gpt-image-1-mini"
      ],
      "platforms": [
        { "platform": "openai" }
      ]
    }
  ],

  "resources": { "memoryMB": 64, "cpu": 0.1, "maxThreads": 32, "maxOpenFiles": 64 },

  "ui": {
    "native": { "entry": "ui/native/entry.js" }
  },

  "hostPermissions": [
    { "id": "platform.register",
      "reason": { "en": "Register the OpenAI API key account type for the built-in openai platform", "zh": "为内置 openai 平台注册 OpenAI API Key 账号类型" } },
    { "id": "ui.native",
      "reason": { "en": "The API key account form (OpenAIKeyForm)", "zh": "API Key 账号表单（OpenAIKeyForm）" } }
  ],

  "externalServices": ["api.openai.com"]
}
