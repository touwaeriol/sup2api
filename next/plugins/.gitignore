# Build outputs of `sub2api-plugin build` / `pack` (never commit packages).
*/runtimes/
*.s2plugin
*/ui/native/dist/

# `go build` in a plugin directory writes the binary there, named after it.
/anthropic/anthropic
/codex/codex
/dynweight/dynweight
/guard/guard
/mailer/mailer
/moderation/moderation
/payment/payment
/volcengine/volcengine
/*/*.exe
